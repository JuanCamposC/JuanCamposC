# URL pública del sitio (usada para SEO, sitemap, Open Graph y canonical)
NEXT_PUBLIC_SITE_URL=https://juancamposc.vercel.app

# Formulario de contacto (Resend — https://resend.com)
# Sin esta clave el formulario mostrará el fallback de correo directo.
RESEND_API_KEY=

# Remitente del correo. Usa un dominio verificado en Resend en producción.
# Por defecto: "Portafolio <onboarding@resend.dev>"
CONTACT_FROM=
